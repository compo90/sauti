# Hugging Face — acces aux modeles Kiriku (TOUS gated : accepter les conditions
# sur huggingface.co pour chaque modele, puis coller un token en lecture).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# --- ASR multilingue (wolof + pulaar + serere), whisper-large-v3 ---
KIRIKU_ASR_MODEL=AIHubSN/M-Kiriku-ASR

# --- TTS par langue (VITS). Pas de TTS serere a ce jour. ---
KIRIKU_TTS_WOL=AIHubSN/Kiriku-Wolof-TTS
KIRIKU_TTS_FUL=AIHubSN/Kiriku-Pulaar-TTS
KIRIKU_TTS_SRR=

# Escalade — contact du poste de sante / sage-femme de garde (district pilote)
ESCALATION_AGENT_PHONE=+221xxxxxxxxx
ESCALATION_WEBHOOK_URL=

LOG_LEVEL=INFO
DEFAULT_LANG=wol
